# Optional: set this only when using Supabase PostgreSQL instead of SQLite.
DATABASE_URL=

# Public URL used in verification and password reset links.
PUBLIC_ORIGIN=http://127.0.0.1:8767

# Email delivery (Resend). Set the API key and a verified sender in production.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# Local private object storage is the default for development. Use S3 for production.
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_DIR=./data/object-storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PATH_STYLE=0
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SSE=

# Phone OTP delivery (Twilio). Mock OTPs are only allowed in tests, or in explicit local development mode.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALLOW_DEV_OTP=0

# A random 32-byte key, encoded as 64 hex characters or base64. Required before KYC documents can be submitted.
KYC_ENCRYPTION_KEY=
KYC_PROVIDER=manual

# Optional: enable Razorpay TEST checkout after Route is approved and sellers have activated linked accounts.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
