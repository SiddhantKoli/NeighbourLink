# Optional: set this only when using Supabase PostgreSQL instead of SQLite.
DATABASE_URL=

# Public URL used in verification and password reset links.
PUBLIC_ORIGIN=http://127.0.0.1:8767

# Email delivery (Resend). Set the API key and a verified sender in production.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# Local private object storage is the default for development. Use S3 for production.
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_DIR=./data/object-storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PATH_STYLE=0
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SSE=
